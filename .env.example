# LLM backends: template (default, offline) | ollama | huggingface
RESUME_CHECKER_LLM_BACKEND=template
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_TOKEN=

# Optional email delivery
SENDGRID_API_KEY=
RESUME_CHECKER_FROM_EMAIL=noreply@example.com

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Runtime
RESUME_CHECKER_MAX_UPLOAD_MB=8
RESUME_CHECKER_MAX_PAGES=6
RESUME_CHECKER_ENABLE_OCR=false
RESUME_CHECKER_REDACT_PII=true
RESUME_CHECKER_EMBEDDING_BACKEND=auto
RESUME_CHECKER_SEMANTIC_MODEL=intfloat/e5-small-v2
RESUME_CHECKER_DOWNLOAD_EVAL_MODELS=false
